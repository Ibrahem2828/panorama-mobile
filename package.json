{
  "name": "panorama-mobile",
  "version": "2.0.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "expo:config": "expo config --type public",
    "validate": "npm run validate:static && npm run typecheck && npm run lint && npm run format:check && npm run expo:config",
    "audit:prod": "npm audit --omit=dev",
    "build:preview": "eas build --platform android --profile preview",
    "build:production": "eas build --platform android --profile production",
    "test": "jest --runInBand",
    "test:ci": "jest --runInBand --coverage",
    "doctor": "npx expo-doctor",
    "validate:release": "npm run validate && npm run doctor && npm run audit:prod",
    "validate:static": "node scripts/validate-project.mjs",
    "start:dev-client": "expo start --dev-client",
    "prebuild:clean": "expo prebuild --clean",
    "build:production:ios": "eas build --platform ios --profile production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "7.16.2",
    "@react-navigation/native": "7.2.5",
    "@react-navigation/native-stack": "7.16.0",
    "expo": "~56.0.17",
    "expo-application": "56.0.3",
    "expo-constants": "~56.0.22",
    "expo-device": "56.0.4",
    "expo-image-picker": "~56.0.22",
    "expo-linking": "~56.0.16",
    "expo-localization": "56.0.6",
    "expo-notifications": "~56.0.22",
    "expo-screen-capture": "56.0.4",
    "expo-secure-store": "56.0.4",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "56.0.4",
    "expo-web-browser": "~56.0.6",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.14",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "jest": "~29.7.0",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.47.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.(ts|tsx|js|jsx)$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ]
        }
      ]
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/assets/**"
    ]
  }
}
