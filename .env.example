EXPO_PUBLIC_APP_ENV=development

# Do not include /api/v1 here because endpoints already include /api/v1.
# Temporary HTTP VPS/Coolify backend for development and runtime testing.
# Production must use HTTPS.
# EXPO_PUBLIC_API_BASE_URL=http://eby52x8qksscjvfeqxf0eob7.76.13.155.172.sslip.io
EXPO_PUBLIC_API_BASE_URL=https://api.xn--mgbaab0cxheq.tech
EXPO_PUBLIC_WS_BASE_URL=wss://api.xn--mgbaab0cxheq.tech
EXPO_PUBLIC_ENABLE_SELF_SERVICE_AUTH=false
# Use ws:// for an HTTP backend and wss:// when the API moves to HTTPS.
# EXPO_PUBLIC_WS_BASE_URL=ws://eby52x8qksscjvfeqxf0eob7.76.13.155.172.sslip.io

# Optional dashboard URL shown on the mobile access-denied screen for operational roles.
# Production store releases must use HTTPS/WSS for API and WebSocket URLs above.
EXPO_PUBLIC_DASHBOARD_URL=https://dashboard.xn--mgbaab0cxheq.tech

# Self-service registration and password reset (default off until Phase 4 backend QA).
# Set to true only after register/OTP/reset flows are validated against the live backend.
EXPO_PUBLIC_ENABLE_SELF_SERVICE_AUTH=false
